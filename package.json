{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "cf:build": "vinext build",
    "cf:deploy": "npm run cf:build && npx wrangler deploy --config wrangler.jsonc",
    "start": "wrangler dev --config wrangler.jsonc",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "reggie:qa": "node scripts/reggie-api-qa.mjs",
    "reggie:api-qa": "node scripts/reggie-api-qa.mjs",
    "reggie:doctor": "node scripts/reggie-doctor.mjs",
    "reggie:full-qa": "node scripts/reggie-full-qa.mjs",
    "reggie:lens-qa": "node scripts/reggie-lens-browser-qa.mjs --skip-performance",
    "reggie:workflow-qa": "node scripts/reggie-workflow-qa.mjs",
    "reggie:routes": "node scripts/reggie-page-registry.mjs sync --root .",
    "reggie:source-map": "node scripts/reggie-source-map.mjs",
    "cf:typegen": "node scripts/reggie-cloudflare-types.mjs sync",
    "cf:typegen:check": "node scripts/reggie-cloudflare-types.mjs check",
    "prebuild": "node scripts/reggie-cloudflare-types.mjs check && npm run reggie:routes && npm run reggie:source-map",
    "precf:build": "npm run reggie:routes && npm run reggie:source-map",
    "precf:deploy": "npm run reggie:routes && npm run reggie:source-map"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5",
    "drizzle-orm": "0.45.2",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react-day-picker": "9.8.1",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "@stripe/stripe-js": "^9.14.0",
    "@stripe/react-stripe-js": "^6.8.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "5.20260911.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.131.1",
    "drizzle-kit": "0.31.10",
    "@playwright/test": "^1.60.0"
  },
  "type": "module"
}
